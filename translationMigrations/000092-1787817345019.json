        {
            "action": "add",
            "key": "needDesc_shelter_housing_and_settlements1",
            "namespace": "drefImportTemplate",
            "value": "Immediate shelter needs and the recovery of housing for displaced or affected populations. It includes emergency shelter provisions, housing repairs, and support for longer-term settlement planning."
        },
        {
            "action": "add",
            "key": "needDesc_shelter_housing_and_settlements2",
            "namespace": "drefImportTemplate",
            "value": "# houses and infrastructure damaged, type/condition of damage (total, severe, partial), availability of public facilities – evacuation shelters, schools, etc. nearby and how are they used."
        },
        {
            "action": "add",
            "key": "nsActionDesc_health1",
            "namespace": "drefImportTemplate",
            "value": "Healthcare services for affected communities, including medical assistance, mental health and psychosocial support, and the prevention of disease outbreaks."
        },
        {
            "action": "add",
            "key": "nsActionDesc_health2",
            "namespace": "drefImportTemplate",
            "value": "Background on affected / not-affected health service delivery, supply chain, and logistics, and what different actors (hospitals, clinics, government, partners, etc…) are doing to support the health-related needs."
        },
        {
            "action": "add",
            "key": "nsActionDesc_health3",
            "namespace": "drefImportTemplate",
            "value": "Common types of infectious diseases in the area / prone in that particular crisis."
        },
        {
            "action": "add",
            "key": "nsActionDesc_health4",
            "namespace": "drefImportTemplate",
            "value": "How affected people are reacting and coping (positive and/or negative coping strategies), and what is the availability and accessibility of MHPSS services and mental health institutions."
        },
        {
            "action": "add",
            "key": "respIndicatorTitleDesc1",
            "namespace": "drefImportTemplate",
            "value": "Start by choosing indicators from the IFRC indicator databank whenever possible. This makes it easier to compare and analyse results across all emergency operations."
        },
        {
            "action": "add",
            "key": "respIndicatorTitleDesc2",
            "namespace": "drefImportTemplate",
            "value": "Pick indicators that align with the planned activities. This ensures that the indicators accurately reflect the actions being taken on the ground. Missing important indicators could mean missed chances to showcase the positive impact of the work being done."
        },
        {
            "action": "add",
            "key": "respIndicatorTitleDesc3",
            "namespace": "drefImportTemplate",
            "value": "Keep in mind that more indicators can mean more work. Each indicator selected requires monitoring, tracking, and reporting, so be sure to choose the ones that best reflect the key outcomes of your actions."
        },
        {
            "action": "add",
            "key": "respIndicatorTitleDesc4",
            "namespace": "drefImportTemplate",
            "value": "Consider the type of indicator unit. For example, it’s often simpler and clearer to track and report on the “number of people” rather than a “percentage of people.”"
        },
        {
            "action": "add",
            "key": "respIsThereMajorCoordinationMechanismDesc1",
            "namespace": "drefImportTemplate",
            "value": "- Inform on the inter-agency / inter-governmental coordination that has been formally or informally set up."
        },
        {
            "action": "add",
            "key": "respIsThereMajorCoordinationMechanismDesc2",
            "namespace": "drefImportTemplate",
