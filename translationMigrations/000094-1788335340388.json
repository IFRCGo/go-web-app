        {
            "action": "update",
            "key": "eapCardText",
            "namespace": "drefAnticipatoryPillar",
            "newValue": "A plan guiding early action activities to reduce and mitigate the humanitarian impact of a forecasted hazard. Developed and approved in peacetime, it combines a pre-agreed plan, preapproved trigger, and guaranteed funding, giving National Societies confidence to act ahead of weather and non-weather-related events. Two types: EAP and sEAP."
        },
        {
            "action": "update",
            "key": "faqImminentProcessImplFunds",
            "namespace": "drefAnticipatoryPillar",
            "newValue": "Manage funds strictly according to the allocated budget."
        },
        {
            "action": "update",
            "key": "faqImminentProcessPlanningBankLetter",
            "namespace": "drefAnticipatoryPillar",
            "newValue": "Attach or reference a valid Bank Letter confirming banking details to avoid delays in disbursement."
        },
        {
            "action": "update",
            "key": "faqImminentProcessPlanningSubmit",
            "namespace": "drefAnticipatoryPillar",
            "newValue": "Sign and submit."
        },
        {
            "action": "update",
            "key": "faqImminentProcessScenarioTwoRequest",
            "namespace": "drefAnticipatoryPillar",
            "newValue": "Submit a request for an additional DREF allocation for response via an operations update. The budget cap of the 2nd allocation should include the 1st imminent DREF allocation."
        },
        {
            "action": "update",
            "key": "imminentCardText",
            "namespace": "drefAnticipatoryPillar",
            "newValue": "For sudden-onset disasters only, when the event has not materialized yet and the National Society has no Early Action Protocol in place to act ahead. The template is short and approval is quick, so your decision-making has to be quick too."
        },
        {
            "action": "add",
            "key": "aaManualButton",
            "namespace": "drefDecisionTree",
            "value": "AA Manual"
        },
        {
            "action": "add",
            "key": "faqCharComponentsDetail",
            "namespace": "drefResponsePillar",
            "value": "Response DREF operations may include:"
        },
        {
            "action": "add",
            "key": "faqCharComponentsTerm",
            "namespace": "drefResponsePillar",
            "value": "Components:"
        },
        {
            "action": "add",
            "key": "faqCharCostDetail",
            "namespace": "drefResponsePillar",
            "value": "a minimum reach of 100 households, or approximately 500 people, is recommended. The indicative cost per beneficiary is CHF 150, and the recommended budget ratio is 60 per cent for direct interventions and 40 per cent for support services. These recommendations do not apply to assessment-focused or epidemic operations where the cost structure may be different."
        },
        {
            "action": "add",
            "key": "faqCharCostTerm",
            "namespace": "drefResponsePillar",
            "value": "Cost considerations:"
        },
        {
            "action": "add",
            "key": "faqCharPlanningDetail",
            "namespace": "drefResponsePillar",
            "value": "the situation analysis, identified needs, operational strategy, activities, targets, indicators and budget must be consistent. Activities should be feasible for the National Society to deliver within the approved timeframe and should complement the response of authorities, Movement partners and other organisations."
        },
        {
            "action": "add",
            "key": "faqCharPlanningTerm",
            "namespace": "drefResponsePillar",
            "value": "Planning and budget:"
        },
        {
            "action": "add",
            "key": "faqCharThresholdsDetail",
            "namespace": "drefResponsePillar",
            "value": "up to CHF 500,000 for Yellow-level emergencies and up to CHF 1,000,000 for Orange-level emergencies. Red-level emergencies are normally addressed through an Emergency Appeal, although DREF Loan support may be considered for critical start-up activities."
        },
        {
            "action": "add",
            "key": "faqCharThresholdsTerm",
            "namespace": "drefResponsePillar",
            "value": "Funding thresholds:"
        },
        {
            "action": "add",
            "key": "faqCharTimeframeDetail",
            "namespace": "drefResponsePillar",
            "value": "For standard Response DREF operations, up to six months for Yellow-level emergencies and up to nine months for Orange-level emergencies. Longer timeframes apply to the Drought DREF parameter when the operation includes anticipatory, response and early recovery activities."
        },
        {
            "action": "add",
            "key": "faqCharTimeframeTerm",
            "namespace": "drefResponsePillar",
            "value": "Operating timeframe:"
        },
        {
            "action": "add",
            "key": "faqCharTriggerDetail",
            "namespace": "drefResponsePillar",
            "value": "a clear trigger based on credible information about the occurrence, scale or worsening impact of an emergency. Triggers may include a sudden-onset disaster, a developing slow-onset crisis, verified impact data, government declarations, disease trends, displacement figures or other evidence of humanitarian need."
        },
        {
            "action": "add",
            "key": "faqCharTriggerTerm",
            "namespace": "drefResponsePillar",
            "value": "Trigger mechanism:"
        },
