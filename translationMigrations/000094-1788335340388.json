    "actions": [
        {
            "action": "add",
            "key": "faqEapCharBudgetDetail",
            "namespace": "drefAnticipatoryPillar",
            "value": "capped at CHF 950,000 (with two activations)."
        },
        {
            "action": "add",
            "key": "faqEapCharBudgetTerm",
            "namespace": "drefAnticipatoryPillar",
            "value": "Total budget:"
        },
        {
            "action": "add",
            "key": "faqEapCharComponentsDetail",
            "namespace": "drefAnticipatoryPillar",
            "value": "the EAP covers three components readiness, prepositioned stock and early actions:"
        },
        {
            "action": "add",
            "key": "faqEapCharComponentsTerm",
            "namespace": "drefAnticipatoryPillar",
            "value": "Components:"
        },
        {
            "action": "add",
            "key": "faqEapCharCoverageDetail",
            "namespace": "drefAnticipatoryPillar",
            "value": "ideally, the EAP has national coverage, however, it may also be localised coverage, depending on the context."
        },
        {
            "action": "add",
            "key": "faqEapCharCoverageTerm",
            "namespace": "drefAnticipatoryPillar",
            "value": "Coverage:"
        },
        {
            "action": "add",
            "key": "faqEapCharEarlyActionDetail",
            "namespace": "drefAnticipatoryPillar",
            "value": "implemented within the lead time between the trigger and the hazard’s impact, ensuring timely assistance. This should be budgeted twice, to take into account the double activation."
        },
        {
            "action": "add",
            "key": "faqEapCharEarlyActionTerm",
            "namespace": "drefAnticipatoryPillar",
            "value": "Early action activities:"
        },
        {
            "action": "add",
            "key": "faqEapCharPrepositionedDetail",
            "namespace": "drefAnticipatoryPillar",
            "value": "two-time (double) stock allocation; prepositioning activities aim to ensure that the National Society has the stock or materials required to implement the early action when the trigger is reached. The first procurement should be done as soon as possible after EAP approval, and the second procurement should be done as soon as possible following the first activation, in preparation for a potential second activation."
        },
        {
            "action": "add",
            "key": "faqEapCharPrepositionedTerm",
            "namespace": "drefAnticipatoryPillar",
            "value": "Prepositioned stock activities:"
        },
        {
            "action": "add",
            "key": "faqEapCharPurposeDetail",
            "namespace": "drefAnticipatoryPillar",
            "value": "a comprehensive funding instrument supporting anticipatory action for weather and non-weather-related hazards with impact-based triggers for extreme events with sufficient lead times and predictable patterns."
        },
        {
            "action": "add",
            "key": "faqEapCharPurposeTerm",
            "namespace": "drefAnticipatoryPillar",
            "value": "Purpose:"
        },
        {
            "action": "add",
            "key": "faqEapCharReadinessDetail",
            "namespace": "drefAnticipatoryPillar",
            "value": "annual capacity building actions, such as simulations and training, salaries for staff, etc., which are done throughout the EAP lifespan, ensuring the National Society has adequate capacity to implement the early action."
        },
        {
            "action": "add",
            "key": "faqEapCharReadinessTerm",
            "namespace": "drefAnticipatoryPillar",
            "value": "Readiness activities:"
        },
        {
            "action": "add",
            "key": "faqEapCharScaleDetail",
            "namespace": "drefAnticipatoryPillar",
            "value": "the EAP must target events that historically have had significant demonstrable humanitarian impact."
        },
        {
            "action": "add",
            "key": "faqEapCharScaleTerm",
            "namespace": "drefAnticipatoryPillar",
            "value": "Scale of event:"
        },
        {
            "action": "add",
            "key": "faqEapCharTimeframeDetail",
            "namespace": "drefAnticipatoryPillar",
            "value": "valid for 5 years once approved."
        },
        {
            "action": "add",
            "key": "faqEapCharTimeframeTerm",
            "namespace": "drefAnticipatoryPillar",
            "value": "Timeframe:"
        },
        {
            "action": "add",
            "key": "faqEapCharTriggerDetail",
            "namespace": "drefAnticipatoryPillar",
            "value": "based on predictions and a predefined thresholds that activate early actions in advance of a foreseen disaster (e.g. cyclone wind speed above 150 km/h; or rainfall predictions for the next 72 hours exceeding 300 mm)."
        },
        {
            "action": "add",
            "key": "faqEapCharTriggerTerm",
            "namespace": "drefAnticipatoryPillar",
            "value": "Trigger mechanism:"
        },
        {
            "action": "add",
            "key": "faqEapProcessDevNoteBelowStandardsDetail",
            "namespace": "drefAnticipatoryPillar",
            "value": "If the protocol is significantly below standards and requires much work which might take more than 3 months, the Validation Committee will close the application and ask the National Society to rework on it and submit a new version as a new application after improvement of the protocol."
        },
        {
            "action": "add",
            "key": "faqEapProcessDevNoteIterationsDetail",
            "namespace": "drefAnticipatoryPillar",
            "value": "if after several iterations, the comments from the Validation Committee are not yet properly addressed and the protocol is still not considered up to standard, the Validation Committee might decide to close the application and request the National Society to rework the comments and submit a new version as a new submission after improvement."
        },
        {
            "action": "add",
            "key": "faqEapProcessTriggerNoteExceptionalDetail",
            "namespace": "drefAnticipatoryPillar",
            "value": "If the pre-agreed trigger is not reached, but the National Society has evidence that the disaster of a similar scale is imminent, the s/EAP might activate based on exceptional approval. The National Society should provide as much supporting information as possible to justify the activation. Exceptional approval will be decided on case-by-case basis."
        },
        {
            "action": "add",
            "key": "faqImminentCharComponentsFocus",
            "namespace": "drefAnticipatoryPillar",
            "value": "as the focus is entirely on immediate early action."
        },
        {
            "action": "add",
            "key": "faqImminentCharComponentsNoReadiness",
            "namespace": "drefAnticipatoryPillar",
            "value": "no readiness and prepositioning activities"
        },
        {
            "action": "add",
            "key": "faqImminentCharComponentsTerm",
            "namespace": "drefAnticipatoryPillar",
            "value": "Components:"
        },
        {
            "action": "add",
            "key": "faqImminentCharEarlyActionDetail",
            "namespace": "drefAnticipatoryPillar",
            "value": "activities which will prevent or mitigate the expected impact of the disaster. Early action activities are time-sensitive and must be implemented rapidly in advance of the hazard. National Societies may include items procurement for immediate use, or replenishment. Early action should be at least 75% of the budget."
        },
        {
            "action": "add",
            "key": "faqImminentCharEarlyActionTerm",
            "namespace": "drefAnticipatoryPillar",
            "value": "Early action activities:"
        },
        {
            "action": "add",
            "key": "faqImminentCharEarlyResponseDetail",
            "namespace": "drefAnticipatoryPillar",
            "value": "only if the disaster has unfolded, and for activities in the first hours and days following the impact of the disaster. Early response should be at most 25% of the budget."
        },
        {
            "action": "add",
            "key": "faqImminentCharEarlyResponseTerm",
            "namespace": "drefAnticipatoryPillar",
            "value": "Early response activities:"
        },
        {
            "action": "add",
            "key": "faqImminentCharTimeframeDetail",
            "namespace": "drefAnticipatoryPillar",
            "value": "45 days, with no possibility of extension."
        },
        {
            "action": "add",
            "key": "faqImminentCharTimeframeTerm",
            "namespace": "drefAnticipatoryPillar",
            "value": "Operating timeframe:"
        },
        {
            "action": "add",
            "key": "faqImminentCharTriggerDetail",
            "namespace": "drefAnticipatoryPillar",
            "value": "no pre-agreed trigger; decision is driven by high-confidence forecasts or expert judgement of an imminent event (e.g. a government or national/regional weather agency issues a severe weather alert for a specific area with high certainty)."
        },
        {
            "action": "add",
            "key": "faqImminentCharTriggerTerm",
            "namespace": "drefAnticipatoryPillar",
            "value": "Trigger mechanism:"
        },
        {
            "action": "add",
            "key": "faqImminentProcessScenarioOneDetail",
            "namespace": "drefAnticipatoryPillar",
            "value": "The disaster does not materialize or materializes but with low impact."
        },
        {
            "action": "add",
            "key": "faqImminentProcessScenarioOneTerm",
            "namespace": "drefAnticipatoryPillar",
            "value": "Scenario 1:"
        },
        {
            "action": "add",
            "key": "faqImminentProcessScenarioTwoDetail",
            "namespace": "drefAnticipatoryPillar",
            "value": "The disaster materializes with high impact and the National Society needs international financial support to assist the affected population."
        },
        {
            "action": "add",
            "key": "faqImminentProcessScenarioTwoTerm",
            "namespace": "drefAnticipatoryPillar",
            "value": "Scenario 2:"
        },
        {
            "action": "add",
            "key": "faqNoteTerm",
            "namespace": "drefAnticipatoryPillar",
            "value": "Note:"
        },
        {
            "action": "add",
            "key": "faqSeapCharBudgetDetail",
            "namespace": "drefAnticipatoryPillar",
            "value": "capped at CHF 220,000 (with one activation)."
        },
        {
            "action": "add",
            "key": "faqSeapCharBudgetTerm",
            "namespace": "drefAnticipatoryPillar",
            "value": "Total budget:"
        },
        {
            "action": "add",
            "key": "faqSeapCharComponentsDetail",
            "namespace": "drefAnticipatoryPillar",
            "value": "the sEAP allows National Societies to access pre-approved funding for readiness and prepositioned stock as well as funding for early action activities – same as the EAP. Based on this experience, a National Society can use the sEAP as a stepping stone, while it works on developing a full EAP."
        },
        {
            "action": "add",
            "key": "faqSeapCharComponentsTerm",
            "namespace": "drefAnticipatoryPillar",
            "value": "Components:"
        },
        {
            "action": "add",
            "key": "faqSeapCharCoverageDetail",
            "namespace": "drefAnticipatoryPillar",
            "value": "ideally, the sEAP has national coverage, however, it may also be localized coverage, depending on the context."
        },
        {
            "action": "add",
            "key": "faqSeapCharCoverageTerm",
            "namespace": "drefAnticipatoryPillar",
            "value": "Coverage:"
        },
        {
            "action": "add",
            "key": "faqSeapCharPurposeDetail",
            "namespace": "drefAnticipatoryPillar",
            "value": "a more accessible and lighter version to enable a National Society. Also applicable for weather and non-weather-related hazards."
        },
        {
            "action": "add",
            "key": "faqSeapCharPurposeTerm",
            "namespace": "drefAnticipatoryPillar",
            "value": "Purpose:"
        },
        {
            "action": "add",
            "key": "faqSeapCharScaleDetail",
            "namespace": "drefAnticipatoryPillar",
            "value": "the sEAP is not meant for events of seasonal average but must target events that historically have had a demonstrable humanitarian impact."
        },
        {
            "action": "add",
            "key": "faqSeapCharScaleTerm",
            "namespace": "drefAnticipatoryPillar",
            "value": "Scale of event:"
        },
        {
            "action": "add",
            "key": "faqSeapCharTimeframeDetail",
            "namespace": "drefAnticipatoryPillar",
            "value": "valid for 2 years once approved."
        },
        {
            "action": "add",
            "key": "faqSeapCharTimeframeTerm",
            "namespace": "drefAnticipatoryPillar",
            "value": "sEAP timeframe:"
        },
        {
            "action": "add",
            "key": "faqSeapCharTriggerDetail",
            "namespace": "drefAnticipatoryPillar",
            "value": "similar to the full EAP, an sEAP needs a clear and concise trigger statement with an identified forecast or expert judgement and threshold; however, less evidence is required, so it may suit hazards where there is less data available."
        },
        {
            "action": "add",
            "key": "faqSeapCharTriggerTerm",
            "namespace": "drefAnticipatoryPillar",
            "value": "Trigger mechanism:"
        },
