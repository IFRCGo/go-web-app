    ],
    "$xpath": "acknowledgement/acknowledgement_001",
    "required": true,
    "$autoname": "acknowledgement_001",
    "appearance": "w8"
   },
   {
    "name": "thanks",
    "type": "note",
    "$kuid": "cfK9qKjgR",
    "label": [
     "Thank you for supporting humanitarian service mapping."
    ],
    "$xpath": "acknowledgement/thanks",
    "$autoname": "thanks",
    "appearance": "w8"
   },
   {
    "name": "acknowledgement",
    "type": "end_group",
    "$kuid": "v9yQiAYf8"
