 "uid": "aHSP",
 "name": "Humanitarian Service Points Mapping",
 "content": {
  "survey": [
   {
    "name": "start",
    "type": "start",
    "$kuid": "toSrIz63o",
    "$xpath": "start",
    "$autoname": "start"
   },
   {
    "name": "end",
    "type": "end",
    "$kuid": "H1Strj8E1",
    "$xpath": "end",
    "$autoname": "end"
   },
   {
    "name": "today",
    "type": "today",
    "$kuid": "sU9Yv68nO",
    "$xpath": "today",
    "$autoname": "today"
   },
   {
    "name": "intro_section",
    "type": "begin_group",
    "$kuid": "PHdYFN96i",
    "$xpath": "intro_section",
    "$autoname": "intro_section",
    "appearance": "field-list"
   },
   {
    "name": "ifrc_logo",
    "type": "note",
    "$kuid": "mu5WNRL0q",
    "label": [
     "International Federation of Red Cross and Red Crescent Societies"
    ],
    "$xpath": "intro_section/ifrc_logo",
    "$autoname": "ifrc_logo",
    "appearance": "w8",
    "media::image": [
     "Logo-Horizontal-RGB-72ppi.png"
    ]
   },
   {
    "name": "intro",
    "type": "note",
    "$kuid": "XgvkUFepP",
    "label": [
     "**Humanitarian Service Point Mapping**\nThis form records humanitarian service points and the services they provide."
    ],
    "$xpath": "intro_section/intro",
    "$autoname": "intro",
    "appearance": "w8"
   },
   {
    "name": "country",
    "type": "select_one",
    "$kuid": "lShCM8hTP",
    "label": [
     "Country"
    ],
    "$xpath": "intro_section/country",
    "required": true,
    "$autoname": "country",
    "appearance": "minimal w4",
    "select_from_list_name": "country"
   },
   {
    "hint": [
     "Yes = record services once, then tick all provinces & districts covered.  No = add each location separately with its own services."
    ],
    "name": "same_services",
    "type": "select_one",
    "$kuid": "034rmOaPL",
    "label": [
     "Are the SAME services offered across all HSP's?"
    ],
    "$xpath": "intro_section/same_services",
    "required": true,
    "$autoname": "same_services",
    "appearance": "minimal w4",
    "select_from_list_name": "yes_no"
   },
   {
    "name": "max_hsps",
    "type": "calculate",
    "$kuid": "Lo8yIN4Eg",
    "$xpath": "intro_section/max_hsps",
    "$autoname": "max_hsps",
    "calculation": "if(${country}='UGA',135,if(${country}='TCD',70,if(${country}='SSD',78,if(${country}='SDN',189,if(${country}='ETH',92,if(${country}='EGY',367,0))))))"
   },
   {
    "hint": [
     "Enter 0 if there are none. Maximum = number of districts in the selected country (${max_hsps})."
    ],
    "name": "num_hsps",
    "type": "integer",
    "$kuid": "IejwFLQNw",
    "label": [
     "How many humanitarian service points (HSPs) are there?"
    ],
    "$xpath": "intro_section/num_hsps",
    "relevant": "${same_services}='no'",
    "required": true,
    "$autoname": "num_hsps",
    "appearance": "w8",
    "constraint": ". >= 0 and . <= ${max_hsps}",
    "constraint_message": "The number of HSPs cannot exceed the number of districts in the selected country (${max_hsps})."
   },
   {
    "hint": [
     "Select all IFRC thematic areas provided."
    ],
    "name": "services_all",
    "type": "select_multiple",
    "$kuid": "bNdQ7oL17",
    "label": [
     "Services offered (applies to ALL locations)"
    ],
    "$xpath": "intro_section/services_all",
    "relevant": "${same_services}='yes'",
    "required": true,
    "$autoname": "services_all",
    "appearance": "w8",
    "select_from_list_name": "services"
   },
   {
    "hint": [
     "Select every province/region where the services above are offered."
    ],
    "name": "province_all",
    "type": "select_multiple",
    "$kuid": "7qIcLyW2a",
    "label": [
     "Provinces / Regions where these services are offered"
    ],
    "$xpath": "intro_section/province_all",
    "relevant": "${same_services}='yes'",
    "required": true,
    "$autoname": "province_all",
    "appearance": "minimal w8",
    "choice_filter": "country=${country}",
    "select_from_list_name": "province"
   },
   {
    "hint": [
     "Select every district where the services above are offered."
    ],
    "name": "district_all",
    "type": "select_multiple",
    "$kuid": "AsS7sghxZ",
    "label": [
     "Districts where these services are offered"
    ],
    "$xpath": "intro_section/district_all",
    "relevant": "${same_services}='yes'",
    "required": true,
    "$autoname": "district_all",
    "appearance": "minimal w8",
    "choice_filter": "selected(${province_all}, province)",
    "select_from_list_name": "district"
   },
   {
    "name": "intro_section",
    "type": "end_group",
    "$kuid": "7Vo9W1TDn"
   },
   {
    "name": "location",
    "type": "begin_repeat",
    "$kuid": "gJNDlRe12",
    "label": [
     "Service point location"
    ],
    "$xpath": "location",
    "relevant": "${same_services}='no'",
    "$autoname": "location",
    "appearance": "field-list",
    "repeat_count": "${num_hsps}"
   },
   {
    "name": "province",
    "type": "select_one",
    "$kuid": "0t4MxHoXu",
    "label": [
     "Province / Region"
    ],
    "$xpath": "location/province",
    "required": true,
    "$autoname": "province",
    "appearance": "minimal w4",
    "choice_filter": "country=${country}",
    "select_from_list_name": "province"
   },
   {
    "name": "district",
    "type": "select_one",
    "$kuid": "7ZZAstFz8",
    "label": [
     "District"
    ],
    "$xpath": "location/district",
    "required": true,
    "$autoname": "district",
    "appearance": "minimal w4",
    "choice_filter": "province=${province} and (not(selected(${selected_districts}, name)) or name=${district})",
    "select_from_list_name": "district"
   },
   {
    "hint": [
     "Select all IFRC thematic areas provided here."
    ],
    "name": "services_loc",
    "type": "select_multiple",
    "$kuid": "GkZAN1I9u",
    "label": [
     "Services offered at THIS location"
    ],
    "$xpath": "location/services_loc",
    "relevant": "${same_services}='no'",
    "required": true,
    "$autoname": "services_loc",
    "appearance": "w8",
    "select_from_list_name": "services"
   },
   {
    "name": "location",
    "type": "end_repeat",
    "$kuid": "EN8qbazvJ"
   },
   {
    "name": "selected_districts",
    "type": "calculate",
    "$kuid": "5M2qj8yip",
    "$xpath": "selected_districts",
    "$autoname": "selected_districts",
    "calculation": "join(' ', ${district})"
   },
   {
    "name": "acknowledgement",
    "type": "begin_group",
    "$kuid": "mqkVTC6vF",
    "label": [
     "Acknowledgement"
    ],
    "$xpath": "acknowledgement",
    "$autoname": "acknowledgement",
    "appearance": "field-list"
   },
   {
    "name": "ack_intro",
    "type": "note",
    "$kuid": "VBLiw2yri",
    "label": [
     "Please review your entries above before submitting."
    ],
    "$xpath": "acknowledgement/ack_intro",
    "$autoname": "ack_intro",
    "appearance": "w8"
   },
   {
    "name": "focal_name",
    "type": "text",
    "$kuid": "l99vbkQY8",
    "label": [
     "Name of person completing this form"
    ],
    "$xpath": "acknowledgement/focal_name",
    "required": true,
    "$autoname": "focal_name",
    "appearance": "w8",
    "constraint": "regex(., \"^[A-Za-zÀ-ÿ '-]+$\")",
    "constraint_message": "Please enter letters only (no numbers, e.g. Jane Doe)."
   },
   {
    "hint": [
     "Optional"
    ],
    "name": "focal_role",
    "type": "text",
    "$kuid": "qPMVRAJhn",
    "label": [
     "Role / position"
    ],
    "$xpath": "acknowledgement/focal_role",
    "$autoname": "focal_role",
    "appearance": "w8"
   },
   {
    "hint": [
     "Required for any follow-ups."
    ],
    "name": "focal_email",
    "type": "text",
    "$kuid": "YK3aRQTmU",
    "label": [
     "Email address"
    ],
    "$xpath": "acknowledgement/focal_email",
    "required": true,
    "$autoname": "focal_email",
    "appearance": "w8",
    "constraint": "regex(., \"^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$\")",
    "constraint_message": "Enter a valid email address (e.g. name@example.org)."
   },
   {
    "name": "acknowledgement_001",
    "type": "acknowledge",
    "$kuid": "MVc7WkbYU",
    "label": [
